# Copy this file to .env and fill in your local secrets.

TMDB_API_KEY=
LUMITRACE_HOST=0.0.0.0
LUMITRACE_PORT=8080

# Optional remote recommendation service. Public deployments should keep the
# URL locked and store any gateway token only on the server.
REMOTE_SEARCH_URL=
# Optional header used only by the backend when its BERT gateway requires one.
REMOTE_SEARCH_TOKEN=

# Set true to ignore the browser Settings page "BERT Service URL" override and
# force REMOTE_SEARCH_URL above. Leave false for self-hosting; set true for any
# public/multi-tenant deployment to prevent server-side request forgery.
LOCK_REMOTE_SEARCH_URL=true

# In-process vector service for the one-container Web demo. The compact index
# directory is the recommended serving format; legacy JSON remains supported.
LUMITRACE_VECTOR_FILE=movie_index
LUMITRACE_MODEL=
LUMITRACE_DEVICE=auto
LUMITRACE_PRELOAD_INDEX=false
LUMITRACE_PREFER_LOCAL_INDEX=false
# auto = load the matching encoder only when a free-text request arrives
# disabled = ID + rating recommendations only (recommended for public CPU demos)
# preload = load the encoder during startup
LUMITRACE_TEXT_SEARCH=auto
# Exclude unrated/near-empty TMDB records from public recommendation lists.
LUMITRACE_MIN_VOTE_COUNT=100

# Optional verified index archive downloaded at container startup.
LUMITRACE_INDEX_URL=
LUMITRACE_INDEX_SHA256=

# Public API controls. Leave origins empty for a same-origin deployment.
LUMITRACE_ALLOWED_ORIGINS=
LUMITRACE_TRUST_PROXY_HEADERS=false
LUMITRACE_RECOMMEND_PER_MINUTE=30
LUMITRACE_TMDB_PER_MINUTE=120

# Public demos should not receive visitors' LLM keys. Enable only on a trusted
# self-host where the operator accepts forwarding client-supplied credentials.
LUMITRACE_ALLOW_CLIENT_LLM=false
# Public mode rejects local/private LLM URLs to avoid SSRF. Set true only for a
# self-hosted BERT process where you intentionally want to use Ollama/LM Studio.
LUMITRACE_ALLOW_PRIVATE_LLM=false
BERT_HOST=127.0.0.1
BERT_PORT=5001

# Keep TLS certificate validation on for public or Internet-facing gateways.
# Set false only for a deliberate local development exception.
SSL_VERIFY=true
