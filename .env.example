# Copy this file to .env and fill in your local secrets.

TMDB_API_KEY=
OMDB_API_KEY=
RAPID_API_KEY=

# Remote services
REMOTE_SEARCH_URL=

# Optional BERT service settings
LUMITRACE_VECTOR_FILE=movie_vectors.json
LUMITRACE_MODEL=AventIQ-AI/bert-movie-recommendation-system
LUMITRACE_DEVICE=auto
BERT_HOST=127.0.0.1
BERT_PORT=5001

# Set true only when the remote services have valid TLS certificates.
SSL_VERIFY=false
