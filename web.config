<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Rule 1: Ollama API Proxy -->
                <!-- Matches /ollama/api/chat -> http://127.0.0.1:11434/api/chat -->
                <rule name="OllamaProxy" stopProcessing="true">
                    <match url="^ollama/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://127.0.0.1:11434/{R:1}" />
                </rule>

                <!-- Rule 2: BERT Service Proxy -->
                <!-- Matches /bert/search -> http://127.0.0.1:5001/search -->
                <rule name="BertServiceProxy" stopProcessing="true">
                    <match url="^bert/(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="http://127.0.0.1:5001/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
